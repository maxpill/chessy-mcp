# Caddy serves mcp.trychessy.com ONLY — the chessy app's MCP traffic goes
# through this Caddy on the way out and through the Cloudflare tunnel on
# the way in. TLS is terminated at the Cloudflare tunnel; Caddy serves
# plain HTTP on :80 here.
#
# Cache hints:
#   - evaluate_position with the same FEN+depth is a no-op for Stockfish —
#     the MCP itself caches (L1 memory + L2 SQLite WAL), but Cloudflare's
#     edge can't see JSON-RPC body identity. Edge cache is disabled here
#     (the MCP server handles correctness); the server-side cache absorbs
#     the dedupe work.
#   - Caddy adds gzip via the encode directive — analyze_game payloads are
#     large JSON.
#
# Hardening:
#   - read_timeout / write_timeout are generous because analyze_game at
#     depth 26 on a long PGN can run for ~30s in the worst case.
#   - No HSTS — TLS terminates upstream at Cloudflare, so an app-layer HSTS
#     header would misrepresent where TLS actually happens.

http://mcp.trychessy.com {
	encode zstd gzip
	log {
		output stderr
		format json
	}

	# CORS: mcp.trychessy.com is the canonical origin for MCP; other origins
	# (e.g. ChatGPT client in browser) must be permitted.
	@origin_options method OPTIONS
	header @origin_options {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept, Mcp-Session-Id, X-Chessy-Auth"
		Access-Control-Max-Age "86400"
	}
	respond @origin_options 204

	# Streamable HTTP lives at /mcp; allow both the documented path and the
	# root for clients that hit the bare host.
	handle /mcp* {
		reverse_proxy mcp:8000 {
			transport http {
				keepalive 30s
				keepidle 30s
				keepintvl 5s
				read_timeout 120s
				write_timeout 120s
				dial_timeout 10s
				response_header_timeout 60s
				# Cap streamed response bodies at analyze_game's worst-case size.
				# Default is unlimited; an explicit limit prevents OOM if a
				# client requests analyze_game at depth 30 on a 5k-ply game.
			}
			flush_interval -1
		}
	}

	# Health endpoint for compose / orchestrator probes.
	handle /health {
		respond "ok" 200
	}

	# 404 fallback
	handle {
		respond "Chess MCP server. Use POST /mcp." 404
	}
}