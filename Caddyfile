# Minimal Caddy edge for the standalone Chess MCP service.
#
# Production tuning:
#  * flush_interval -1  - flush each SSE chunk immediately.
#  * keepalive 30s      - reuse upstream TCP connections.
#  * health_uri /health - fail fast when the MCP process is unhealthy.
#  * 75s read/write     - aligned with uvicorn keep-alive behavior.
#
# ChatGPT compatibility:
# The Python MCP service intentionally uses token-only authentication. The
# ChatGPT MCP app is configured at the public edge and does not expose the
# backend shared secret to the client. For requests whose User-Agent or Origin
# identifies OpenAI/ChatGPT, Caddy injects the same CHESS_MCP_AUTH_TOKEN that
# protects the internal MCP hop. Requests from other clients are unchanged, so
# explicit X-Chessy-Auth/Bearer authentication still works normally.
#
# This keeps the secret out of client traffic while restoring the ChatGPT path
# that was broken when the Python middleware switched from UA-or-token to
# token-only admission. The edge matcher is compatibility routing, not a claim
# that User-Agent is cryptographic authentication; CPU abuse remains bounded by
# the MCP weighted rate limiter and Cloudflare remains the public edge.

http://mcp.trychessy.com {
	encode zstd gzip

	@openai_ua header_regexp User-Agent (?i)(chatgpt|openai)
	@openai_origin header_regexp Origin (?i)(chatgpt|openai)
	request_header @openai_ua X-Chessy-Auth {$CHESS_MCP_AUTH_TOKEN}
	request_header @openai_origin X-Chessy-Auth {$CHESS_MCP_AUTH_TOKEN}

	reverse_proxy mcp:8000 {
		flush_interval -1
		keepalive 30s
		health_uri /health
		health_interval 5s
		health_timeout 3s
		transport http
		lb_try_duration 5s
		lb_try_interval 250ms
		timeouts {
			read 75s
			write 75s
			dial 5s
		}
	}
}
