# Minimal Caddy edge for the standalone Chess MCP service.
#
# Production behavior:
#  * flush_interval -1  - flush each SSE chunk immediately.
#  * active /health     - fail fast when the MCP process is unhealthy.
#  * retry window       - briefly retry a temporarily unavailable upstream.
#
# Authentication boundary:
# The public hostname is already reached through the Cloudflare tunnel and this
# Caddy instance is the trusted gateway to the private mcp:8000 service. Caddy
# therefore authenticates the internal hop by injecting CHESS_MCP_AUTH_TOKEN on
# every proxied request. The Python MCP service stays token-only and cannot be
# called directly from another container without the secret.
#
# Do not key this handoff off User-Agent or Origin. The ChatGPT MCP transport
# does not guarantee an OpenAI/ChatGPT-identifying value there, and those fields
# are spoofable anyway. Public admission and abuse control belong at the edge;
# the MCP service additionally applies its weighted per-client rate limiter.
#
# Keep the reverse_proxy block deliberately conservative. A previous config
# used unsupported direct `keepalive` and `timeouts` subdirectives; Caddy 2
# rejects that config before startup. Default HTTP transport already reuses
# upstream connections, so those knobs are unnecessary here.

http://mcp.trychessy.com {
	encode zstd gzip

	request_header X-Chessy-Auth {$CHESS_MCP_AUTH_TOKEN}

	reverse_proxy mcp:8000 {
		flush_interval -1
		health_uri /health
		health_interval 5s
		health_timeout 3s
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
