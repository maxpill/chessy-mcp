# Stockfish pool size — one engine per concurrent MCP request.
# Default = min(cpu_count, 8). 8 matches the OVH production box.
CHESS_MCP_POOL_SIZE=8

# Stockfish hash table per engine, in MiB.
STOCKFISH_HASH_MB=256

# Bearer token the chessy app uses to authenticate. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the same name in the chessy app's .env.
CHESS_MCP_AUTH_TOKEN=

# When true, only known ChatGPT/OpenAI MCP clients OR requests carrying a
# valid CHESS_MCP_AUTH_TOKEN are served. Public deployment should leave
# this ON.
CHESS_MCP_LOCK_CHATGPT=true