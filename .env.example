# Stockfish pool size — one engine per concurrent MCP request.
# Default = min(cpu_count, 8). 8 matches the OVH production box.
CHESS_MCP_POOL_SIZE=8

# Stockfish hash table per engine, in MiB.
STOCKFISH_HASH_MB=256

# Threads per Stockfish worker. Default 1 keeps the OVH 4C/8T host at one
# logical core per engine process; raise to 2 only if pool_size is dropped
# accordingly (or the host has more physical cores than pool_size*threads).
STOCKFISH_THREADS_PER_WORKER=1

# Cap on concurrent engine evaluations across all tools. analyze_game fans
# out one evaluation per ply via asyncio.gather; without this cap a single
# mega-burst can starve every other request. 16 = 2x pool size is a safe
# default; raise if you're confident your host has headroom.
CHESS_MCP_MAX_CONCURRENT_EVALUATES=16

# Path to the L2 SQLite cache. On a tmpfs mount for fast reads/writes;
# the in-process L1 cache (50k entries) survives restarts and warms the
# L2 back up within an hour of traffic.
CHESS_MCP_CACHE_DB=/cache/chess_mcp_eval_cache.sqlite3

# Bearer token the chessy app uses to authenticate. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the same name in the chessy app's .env.
CHESS_MCP_AUTH_TOKEN=

# When true, only known ChatGPT/OpenAI MCP clients OR requests carrying a
# valid CHESS_MCP_AUTH_TOKEN are served. Public deployment should leave
# this ON.
CHESS_MCP_LOCK_CHATGPT=true