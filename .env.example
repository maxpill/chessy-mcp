# Stockfish pool size - one engine per concurrent MCP request.
# Production currently uses 4 workers with 2 threads each on an 8-thread host.
CHESS_MCP_POOL_SIZE=4

# Stockfish hash table per engine, in MiB.
STOCKFISH_HASH_MB=64

# Threads per Stockfish worker. Keep pool_size * threads_per_worker close to
# the host's available logical CPU count.
STOCKFISH_THREADS_PER_WORKER=2

# Cap on concurrent engine evaluations across all tools.
CHESS_MCP_MAX_CONCURRENT_EVALUATES=8

# Path to the L2 SQLite cache. Production mounts this path on tmpfs.
CHESS_MCP_CACHE_DB=/cache/chess_mcp_eval_cache.sqlite3

# Bearer token used to authenticate HTTP MCP requests. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Public deployments with CHESS_MCP_LOCK_CHATGPT=true MUST set this value.
CHESS_MCP_AUTH_TOKEN=

# When true, every non-health HTTP request requires CHESS_MCP_AUTH_TOKEN.
# User-Agent and Origin strings are not authentication signals.
CHESS_MCP_LOCK_CHATGPT=true

# Build identity. Deployment should export BUILD_SHA=$(git rev-parse HEAD)
# before running docker compose so responses and cache identity identify the
# exact deployed revision.
BUILD_SHA=
CHESSY_PACKAGE_VERSION=0.1.0

# Bearer token for the Lichess Opening Explorer
# (https://lichess.org/settings/oauth/token, scope: explorer:read).
# The token is sent to https://explorer.lichess.ovh on every explore_opening
# call. Missing token makes the tool raise MISSING_TOKEN at runtime rather
# than silently dropping queries.
LICHESS_EXPLORER_TOKEN=

# Override only for self-hosted explorer or test fixtures. Public default is
# https://explorer.lichess.ovh.
LICHESS_EXPLORER_ENDPOINT=https://explorer.lichess.ovh

# =============================================================================
# chess-ocr sidecar (multi-pass M3 multimodal OCR for score sheets)
# =============================================================================
# M3 multimodal API key — used by the chess-ocr sidecar only.
# The MCP server does NOT need this value; it talks to the sidecar over
# the internal mcp-net bridge.
#
# Treat this as a secret: never commit the real value, never echo it in logs.
# Variable name is intentionally a single letter per project convention.
n=
#
# Override only for self-hosted OCR sidecar or test fixtures.
# Public default is the in-network docker-compose service name.
OCR_SIDECAR_URL=http://chess-ocr:9552
# Override only for self-hosted M3 API endpoint or test fixtures.
OCR_API_BASE=https://api.MiniMax.io/v1
# Pinned model id; do NOT change in production without a re-audit.
OCR_MODEL=MiniMax-M3
# Defensive cap on multi-pass consensus.
OCR_MAX_PASSES=6
OCR_TARGET_VERIFIER_CONFIDENCE=0.9
# Per-pass HTTP timeout to M3. 360s is the empirically derived sweet spot
# — long enough for M3's reasoning loop to finish on messy handwritten
# Polish score sheets, short enough to avoid runaway token burn.
# Benchmark (40-photo corpus, see tests/real_photos_report/report.md):
#   240s -> 38/40 valid  (2 hard cases timed out)
#   360s -> 40/40 valid
OCR_PER_PASS_TIMEOUT_S=360

# =============================================================================
# ocr_to_pgn v2 — image-source sandboxing
# =============================================================================
# Comma-separated list of hostnames the ``ocr_to_pgn`` v2 ``{"kind":"url",...}``
# source is allowed to fetch from. Empty (the default) blocks ALL remote
# hosts except ``localhost`` / ``127.0.0.1`` / ``::1`` — set this to your
# chessy app's image CDN before enabling remote photo uploads.
CHESSY_MCP_URL_ALLOWLIST=
#
# Absolute path the ``{"kind":"file_uri",...}`` source must resolve under.
# Reads outside this directory are rejected with FILE_OUTSIDE_SANDBOX.
# Default: /tmp
CHESSY_MCP_FILE_ROOT=/tmp
