# chess-ocr sidecar image — multi-pass M3 multimodal OCR for chess score sheets.
# Stateless FastAPI service; the MCP server calls it over the internal mcp-net bridge.

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ARG BUILD_SHA=unknown
ARG CHESSY_PACKAGE_VERSION=0.1.0

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    UVLOOP_DISABLE_IMPORT_ERRORS=1 \
    BUILD_SHA=${BUILD_SHA} \
    CHESSY_PACKAGE_VERSION=${CHESSY_PACKAGE_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tini libheif-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency layer
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra ocr

# Application code
COPY mcp_server ./mcp_server
COPY core ./core

EXPOSE 9552

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD /opt/venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9552/health', timeout=2)" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/opt/venv/bin/python", "-m", "core.chess_ocr.main"]
